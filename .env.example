# DB
DATABASE_URL=postgresql+psycopg2://aibot:aibot@postgres:5432/aibot

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Ollama (локальная LLM)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Telethon
TG_API_ID=123456
TG_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TG_SESSION_NAME=aibot_session

# Куда публикуем (канал)
TG_TARGET_CHANNEL=@названиеканала

# Источник TG для чтения (публичный канал)
TG_SOURCE_CHANNEL=@названиеканала

# RSS источник (1 сайт)
RSS_FEED_URL=https://habr.com/ru/rss/articles/